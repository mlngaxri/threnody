# THRENODY environment
#
# Every value here is optional. The application boots and serves the complete
# archive with none of them set, because the content is compiled into the
# bundle rather than fetched from an external service. Copy this file to
# .env.local for local development.
#
# Nothing in this file is a secret, and no secret is ever read in client code.
# Any variable that is not prefixed with NEXT_PUBLIC_ is server only.

# Canonical origin, used for absolute URLs in metadata, sitemap, RSS and
# JSON-LD. On Vercel this is derived automatically from
# VERCEL_PROJECT_PRODUCTION_URL, so it only needs setting for a custom domain.
# SITE_URL=https://threnody.example

# Marks a deployment as a preview so robots.txt disallows indexing. Vercel sets
# VERCEL_ENV automatically; this override is only for testing that behaviour
# locally.
# PREVIEW=1
