{
  "name": "threnody",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "THRENODY, an atlas of sounds that no longer exist. An acoustic archaeology archive.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/alias-loader-register.mjs --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "next": "15.5.9",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@types/node": "22.10.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.4",
    "typescript": "5.7.3"
  }
}
